<Project>
  <PropertyGroup>
    <LangVersion>7.3</LangVersion>
    <Version>1.2.1</Version>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
