<Window x:Class="CadHdScreenshot.Plugin.ScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAD 综合工具" Width="500" Height="680" MinWidth="440" MinHeight="540"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#1E293B"
        Background="#F5F7FB" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#64748B" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="19" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2563EB" />
                <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2563EB" />
                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65" /></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#2563EB" /><Setter Property="BorderBrush" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="CaptureButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="70" /><Setter Property="Padding" Value="14,10" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
    </Style>
    <Style x:Key="ScaleItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="8,8" /><Setter Property="Margin" Value="3" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chrome" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#93B4F4" /></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#EFF6FF" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2563EB" />
                <Setter Property="Foreground" Value="#1D4ED8" /><Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderThickness" Value="2" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="20,11" /><Setter Property="Foreground" Value="#64748B" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Chrome" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2563EB" />
                <Setter Property="Foreground" Value="#1D4ED8" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#EAF0FA" /></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#EAF0FA" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="9,7" /><Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="22,16,22,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="CAD 综合工具" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Text="清晰分享方案，轻松整理标注" Style="{StaticResource Hint}" Margin="0,5,0,0" />
      </StackPanel>
      <Border Grid.Column="1" Background="#E8EEF9" CornerRadius="5" Padding="8,4" VerticalAlignment="Top" Margin="12,4,0,0">
        <TextBlock Text="{Binding VersionLabel}" Foreground="#526581" FontSize="11" />
      </Border>
    </Grid>

    <TabControl x:Name="ToolTabs" Grid.Row="1" Margin="16,0" Background="Transparent" BorderThickness="0" IsEnabled="{Binding IsIdle}">
      <TabItem Header="高清截图">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10,0,6"
                      Foreground="#1E293B" FontWeight="Normal">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="14,12">
              <StackPanel>
                <TextBlock Text="1  选择清晰度" Style="{StaticResource SectionTitle}" />
                <ListBox ItemsSource="{Binding ScaleOptions}" SelectedItem="{Binding SelectedScale}"
                         ItemContainerStyle="{StaticResource ScaleItem}" BorderThickness="0" Background="Transparent"
                         Margin="-3,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="截图清晰度" ToolTip="使用方向键切换清晰度；2× 适合日常发送方案。">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>
                <WrapPanel Margin="0,8,0,0">
                  <TextBlock Text="视口参考尺寸  " Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                  <TextBlock FontWeight="SemiBold">
                    <Run Text="{Binding PreviewWidth, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding PreviewHeight, Mode=OneWay}" /><Run Text=" px" />
                  </TextBlock>
                </WrapPanel>
                <TextBlock Text="实际尺寸随框选比例调整，返回窗口时更新。" Style="{StaticResource Hint}" Margin="0,2,0,0" />
              </StackPanel>
            </Border>

            <TextBlock Text="2  点击一种效果，开始框选" Style="{StaticResource SectionTitle}" Margin="2,14,0,8" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Button Command="{Binding CaptureOriginalCommand}" Style="{StaticResource CaptureButton}" Background="#EFF6FF"
                      BorderBrush="#BFDBFE" Margin="0,0,5,10" AutomationProperties.Name="原色截图">
                <StackPanel><TextBlock Text="原色图" FontSize="15" FontWeight="SemiBold" Foreground="#1D4ED8" />
                  <TextBlock Text="保留当前 CAD 配色" Style="{StaticResource Hint}" Margin="0,5,0,0" /></StackPanel>
              </Button>
              <Button Grid.Column="1" Command="{Binding CaptureWhiteBackgroundCommand}" Style="{StaticResource CaptureButton}"
                      Margin="5,0,0,10" AutomationProperties.Name="白底截图">
                <StackPanel><TextBlock Text="白底图" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="白色背景，保留彩色" Style="{StaticResource Hint}" Margin="0,5,0,0" /></StackPanel>
              </Button>
              <Button Grid.Row="1" Command="{Binding CaptureBlackAndWhiteCommand}" Style="{StaticResource CaptureButton}"
                      Margin="0,0,5,0" AutomationProperties.Name="黑白截图">
                <StackPanel><TextBlock Text="黑白图" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="纯黑白，高对比呈现" Style="{StaticResource Hint}" Margin="0,5,0,0" /></StackPanel>
              </Button>
              <Button Grid.Row="1" Grid.Column="1" Command="{Binding CaptureGrayscaleCommand}" Style="{StaticResource CaptureButton}"
                      Margin="5,0,0,0" AutomationProperties.Name="黑白灰截图">
                <StackPanel><TextBlock Text="黑白灰" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="灰度层次，弱化色彩" Style="{StaticResource Hint}" Margin="0,5,0,0" /></StackPanel>
              </Button>
            </Grid>
            <Border Background="#EAF4F1" CornerRadius="7" Padding="12,10" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="完成后直接 Ctrl+V 粘贴" Foreground="#216653" FontWeight="SemiBold" />
                <TextBlock Text="不生成本地文件 · 框选时按 Esc 可取消" Foreground="#40796A" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Expander Header="快捷命令设置" Margin="2,12,2,0" Padding="0,0,0,2">
              <StackPanel Margin="0,12,0,0">
                <TextBlock Text="在 CAD 命令行输入此命令，即可打开工具。" Style="{StaticResource Hint}" />
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox Text="{Binding CustomCommand, UpdateSourceTrigger=PropertyChanged}" MaxLength="16"
                           AutomationProperties.Name="自定义 CAD 命令" ToolTip="以英文字母开头，最多 16 位；支持数字、下划线和短横线。" />
                  <Button Grid.Column="1" Content="保存命令" Command="{Binding SaveCustomCommandCommand}" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding CustomCommandHint}" Margin="0,6,0,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                      <Style.Triggers><DataTrigger Binding="{Binding IsCustomCommandValid}" Value="False"><Setter Property="Foreground" Value="#B45309" /></DataTrigger></Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="标注样式">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10,0,6"
                      Foreground="#1E293B" FontWeight="Normal">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="1  选择目标样式" Style="{StaticResource SectionTitle}" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <ComboBox ItemsSource="{Binding DimensionStyleOptions}" SelectedItem="{Binding SelectedDimensionStyle}"
                            MinHeight="38" Padding="8,5" VerticalContentAlignment="Center" AutomationProperties.Name="目标标注样式" />
                  <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshDimensionStylesCommand}"
                          Margin="8,0,0,0" ToolTip="切换图纸或新增样式后，刷新当前图纸的列表。" />
                </Grid>
                <TextBlock Text="{Binding DimensionStylesHint}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="2  确定块内修改范围" Style="{StaticResource SectionTitle}" />
                <RadioButton IsChecked="{Binding ModifySelectedBlockOnly}" GroupName="BlockDimensionScope" Padding="6,2" Margin="0,4,0,12">
                  <StackPanel><TextBlock Text="仅选中的块实例（推荐）" FontWeight="SemiBold" />
                    <TextBlock Text="其他同名块保持原样；不处理动态块。" Style="{StaticResource Hint}" Margin="0,5,0,0" /></StackPanel>
                </RadioButton>
                <RadioButton IsChecked="{Binding ModifyAllSameNameBlocks}" GroupName="BlockDimensionScope" Padding="6,2">
                  <StackPanel><TextBlock Text="所有同名块" FontWeight="SemiBold" />
                    <TextBlock Text="共享块定义的其他实例也会同步变化。" Style="{StaticResource Hint}" Margin="0,5,0,0" /></StackPanel>
                </RadioButton>
                <Border Background="#FFF7E6" CornerRadius="6" Padding="10" Margin="0,12,0,0"
                        Visibility="{Binding ModifyAllSameNameBlocks, Converter={StaticResource BoolVisibility}}">
                  <TextBlock Text="此模式会影响未选中的同名块，请确认修改范围。" Foreground="#92400E" FontSize="12" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Border>
            <Button Content="选择对象并应用样式" Command="{Binding ApplyDimensionStyleCommand}"
                    Style="{StaticResource PrimaryButton}" MinHeight="44" Margin="0,16,0,0" />
            <TextBlock Text="可混选标注、图形和块，只修改其中的标注。选好后按 Enter 确认，按 Esc 取消。当前不递归处理嵌套块。"
                       Style="{StaticResource Hint}" Margin="3,10,3,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,8,0,0">
      <StackPanel>
        <ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}" BorderThickness="0" Foreground="#2563EB"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
        <Grid Margin="18,11">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="状态" Foreground="#64748B" Margin="0,6,10,0" FontSize="12" />
          <TextBox Grid.Column="1" Text="{Binding Status, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                   BorderThickness="0" Background="Transparent" Padding="0,4" TextWrapping="Wrap" MaxHeight="88"
                   VerticalScrollBarVisibility="Auto" FontSize="12" AutomationProperties.Name="操作状态"
                   ToolTip="可选中并复制状态信息或日志路径。" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
