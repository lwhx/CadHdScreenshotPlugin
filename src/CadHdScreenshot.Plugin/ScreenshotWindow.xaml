<Window x:Class="CadHdScreenshot.Plugin.ScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAD 综合工具"
        Width="430" Height="560" MinWidth="410" MinHeight="530"
        Background="#F4F5F7" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <Style x:Key="ChoiceItemStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#B8C0CC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Border" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="#1683E8" />
                <Setter TargetName="Border" Property="Background" Value="#EFF7FF" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="#0877D1" />
                <Setter TargetName="Border" Property="Background" Value="#DDEFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GroupTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#0877D1" />
    </Style>
    <Style x:Key="CaptureButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="42" />
      <Setter Property="Margin" Value="3,4" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#B8C0CC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#DDEFFF" />
          <Setter Property="BorderBrush" Value="#0877D1" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="22,8" />
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="2,0,2,10">
      <Border Width="22" Height="22" Background="#0877D1" CornerRadius="3" Margin="0,0,8,0">
        <TextBlock Text="⌁" Foreground="White" FontSize="18"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Text="CAD 综合工具" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>

    <TabControl Grid.Row="1" Background="White" BorderBrush="#C8CED7">
      <TabItem Header="截图">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.05*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Background="White" BorderBrush="#D0D5DC">
              <GroupBox.Header><TextBlock Text="图片像素设置" Style="{StaticResource GroupTitleStyle}" /></GroupBox.Header>
              <StackPanel Margin="10,8,10,10">
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="32" /></Grid.RowDefinitions>
                  <TextBlock Text="高" Foreground="#0877D1" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding PreviewHeight}" IsReadOnly="True"
                           VerticalContentAlignment="Center" Background="#F7F8FA" BorderBrush="#C4CAD2" />
                  <TextBlock Grid.Row="1" Text="宽" Foreground="#0877D1" VerticalAlignment="Center" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PreviewWidth}" IsReadOnly="True"
                           VerticalContentAlignment="Center" Background="#F7F8FA" BorderBrush="#C4CAD2" />
                </Grid>
                <TextBlock Text="选择清晰度" Foreground="#606A78" Margin="3,0,0,3" />
                <ListBox ItemsSource="{Binding ScaleOptions}" SelectedItem="{Binding SelectedScale}"
                         ItemContainerStyle="{StaticResource ChoiceItemStyle}"
                         BorderThickness="0" Background="Transparent">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>
                <TextBlock Text="预计尺寸按当前 CAD 视口计算" Foreground="#79828E"
                           FontSize="11" TextWrapping="Wrap" Margin="3,8,0,0" />
              </StackPanel>
            </GroupBox>
            <GroupBox Grid.Column="2" Background="White" BorderBrush="#D0D5DC">
              <GroupBox.Header>
                <TextBlock Text="截图类型" FontSize="14" FontWeight="SemiBold" Foreground="#E43EBE" />
              </GroupBox.Header>
              <StackPanel Margin="8">
                <Button Content="1. 截原色图" Command="{Binding CaptureOriginalCommand}" Style="{StaticResource CaptureButtonStyle}" />
                <Button Content="2. 截黑白图" Command="{Binding CaptureBlackAndWhiteCommand}" Style="{StaticResource CaptureButtonStyle}" />
                <Button Content="3. 截白底图" Command="{Binding CaptureWhiteBackgroundCommand}" Style="{StaticResource CaptureButtonStyle}" />
                <Button Content="4. 截黑白灰" Command="{Binding CaptureGrayscaleCommand}" Style="{StaticResource CaptureButtonStyle}" />
              </StackPanel>
            </GroupBox>
          </Grid>
          <Border Grid.Row="1" Margin="0,10,0,0" Padding="10,8" Background="#F7FAFC"
                  BorderBrush="#D0D5DC" BorderThickness="1">
            <TextBlock Text="✓ 截图后直接复制到剪贴板，不保存本地文件" Foreground="#334155" />
          </Border>

          <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,8" Background="#F7FAFC"
                  BorderBrush="#D0D5DC" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="自定义命令" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1" Text="{Binding CustomCommand, UpdateSourceTrigger=PropertyChanged}"
                       MaxLength="16" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0" />
              <Button Grid.Column="2" Content="保存" Command="{Binding SaveCustomCommandCommand}" Width="64" Height="28" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="标注样式">
        <StackPanel Margin="14">
          <GroupBox BorderBrush="#D0D5DC">
            <GroupBox.Header>
              <TextBlock Text="批量更换标注样式" Style="{StaticResource GroupTitleStyle}" />
            </GroupBox.Header>
            <StackPanel Margin="12">
              <TextBlock Text="选择目标样式后，可以把标注和普通图形一起框选；工具只修改其中的标注。"
                         Foreground="#5C6673" TextWrapping="Wrap" Margin="0,0,0,12" />
              <TextBlock Text="目标标注样式" Foreground="#606A78" Margin="0,0,0,5" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding DimensionStyleOptions}"
                          SelectedItem="{Binding SelectedDimensionStyle}"
                          Height="32" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshDimensionStylesCommand}"
                        Width="66" Height="32" Margin="8,0,0,0" />
              </Grid>
              <TextBlock Text="块内标注处理范围" Foreground="#606A78" Margin="0,14,0,5" />
              <StackPanel>
                <RadioButton Content="仅修改当前选中的块实例（推荐）"
                             IsChecked="{Binding ModifySelectedBlockOnly}"
                             GroupName="BlockDimensionScope" Margin="2,4" />
                <RadioButton Content="修改所有同名块"
                             IsChecked="{Binding ModifyAllSameNameBlocks}"
                             GroupName="BlockDimensionScope" Margin="2,4" />
              </StackPanel>
              <Button Content="选择对象并更换" Command="{Binding ApplyDimensionStyleCommand}"
                      Height="42" Margin="0,14,0,0" FontSize="14" FontWeight="SemiBold"
                      Foreground="White" Background="#0877D1" BorderBrush="#0868B5" />
            </StackPanel>
          </GroupBox>

          <Border Margin="0,14,0,0" Padding="12" Background="#F7FAFC"
                  BorderBrush="#D0D5DC" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="使用方法" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
              <TextBlock Text="1. 选择目标标注样式和块处理范围。&#x0a;2. 点击“选择对象并更换”。&#x0a;3. 框选任意标注、图形或块，按 Enter 完成。"
                         Foreground="#5C6673" TextWrapping="Wrap" LineHeight="22" />
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>

      <TabItem Header="栏目三">
        <Grid Margin="14">
          <Border Padding="18" Background="#F7FAFC" BorderBrush="#D0D5DC" BorderThickness="1">
            <TextBlock Text="栏目三功能暂未添加" Foreground="#79828E"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap"
               Margin="2,10,2,0" Foreground="#5C6673" />
  </Grid>
</Window>
