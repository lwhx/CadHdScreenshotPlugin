<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CadHdScreenshot.Plugin.ScreenshotWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CAD 综合工具" Width="430" Height="560" MinWidth="410" MinHeight="530" Background="#F4F5F7" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" xmlns:plugin="clr-namespace:CadHdScreenshot.Plugin;assembly=CadHdScreenshot.Plugin">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="ChoiceItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#B8C0CC" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="Border" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Border.BorderBrush" Value="#1683E8" />
                  <Setter TargetName="Border" Property="Border.Background" Value="#EFF7FF" />
                </Trigger>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="Border" Property="Border.BorderBrush" Value="#0877D1" />
                  <Setter TargetName="Border" Property="Border.Background" Value="#DDEFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="GroupTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#0877D1" />
      </Style>
      <Style x:Key="CaptureButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="3,4" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#B8C0CC" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#DDEFFF" />
            <Setter Property="BorderBrush" Value="#0877D1" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="22,8" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="2,0,2,10">
      <Border Width="22" Height="22" Background="#0877D1" CornerRadius="3" Margin="0,0,8,0">
        <TextBlock Text="⌁" Foreground="#FFFFFFFF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Text="CAD 综合工具" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>
    <TabControl Grid.Row="1" Background="#FFFFFFFF" BorderBrush="#C8CED7">
      <TabItem Header="截图">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.05*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Background="#FFFFFFFF" BorderBrush="#D0D5DC">
              <HeaderedContentControl.Header>
                <TextBlock Text="图片像素设置" Style="{StaticResource GroupTitleStyle}" />
              </HeaderedContentControl.Header>
              <StackPanel Margin="10,8,10,10">
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="高" Foreground="#0877D1" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center" Background="#F7F8FA" BorderBrush="#C4CAD2" Text="{Binding PreviewHeight}" />
                  <TextBlock Grid.Row="1" Text="宽" Foreground="#0877D1" VerticalAlignment="Center" />
                  <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center" Background="#F7F8FA" BorderBrush="#C4CAD2" Text="{Binding PreviewWidth}" />
                </Grid>
                <TextBlock Text="选择清晰度" Foreground="#606A78" Margin="3,0,0,3" />
                <ListBox ItemContainerStyle="{StaticResource ChoiceItemStyle}" BorderThickness="0" Background="#00FFFFFF" ItemsSource="{Binding ScaleOptions}" SelectedItem="{Binding SelectedScale}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ListBox>
                <TextBlock Text="预计尺寸按当前 CAD 视口计算" Foreground="#79828E" FontSize="11" TextWrapping="Wrap" Margin="3,8,0,0" />
              </StackPanel>
            </GroupBox>
            <GroupBox Grid.Column="2" Background="#FFFFFFFF" BorderBrush="#D0D5DC">
              <HeaderedContentControl.Header>
                <TextBlock Text="截图类型" FontSize="14" FontWeight="SemiBold" Foreground="#E43EBE" />
              </HeaderedContentControl.Header>
              <StackPanel Margin="8">
                <Button Content="1. 截原色图" Style="{StaticResource CaptureButtonStyle}" Command="{Binding CaptureOriginalCommand}" />
                <Button Content="2. 截黑白图" Style="{StaticResource CaptureButtonStyle}" Command="{Binding CaptureBlackAndWhiteCommand}" />
                <Button Content="3. 截白底图" Style="{StaticResource CaptureButtonStyle}" Command="{Binding CaptureWhiteBackgroundCommand}" />
                <Button Content="4. 截黑白灰" Style="{StaticResource CaptureButtonStyle}" Command="{Binding CaptureGrayscaleCommand}" />
              </StackPanel>
            </GroupBox>
          </Grid>
          <Border Grid.Row="1" Margin="0,10,0,0" Padding="10,8" Background="#F7FAFC" BorderBrush="#D0D5DC" BorderThickness="1">
            <TextBlock Text="✓ 截图后直接复制到剪贴板，不保存本地文件" Foreground="#334155" />
          </Border>
          <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,8" Background="#F7FAFC" BorderBrush="#D0D5DC" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="自定义命令" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1" MaxLength="16" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0" Text="{Binding CustomCommand, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="2" Content="保存" Width="64" Height="28" Command="{Binding SaveCustomCommandCommand}" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="标注样式">
        <StackPanel Margin="14">
          <GroupBox BorderBrush="#D0D5DC">
            <HeaderedContentControl.Header>
              <TextBlock Text="批量更换标注样式" Style="{StaticResource GroupTitleStyle}" />
            </HeaderedContentControl.Header>
            <StackPanel Margin="12">
              <TextBlock Text="选择目标样式后，可以把标注和普通图形一起框选；工具只修改其中的标注。" Foreground="#5C6673" TextWrapping="Wrap" Margin="0,0,0,12" />
              <TextBlock Text="目标标注样式" Foreground="#606A78" Margin="0,0,0,5" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Height="32" VerticalContentAlignment="Center" ItemsSource="{Binding DimensionStyleOptions}" SelectedItem="{Binding SelectedDimensionStyle}" />
                <Button Grid.Column="1" Content="刷新" Width="66" Height="32" Margin="8,0,0,0" Command="{Binding RefreshDimensionStylesCommand}" />
              </Grid>
              <TextBlock Text="块内标注处理范围" Foreground="#606A78" Margin="0,14,0,5" />
              <StackPanel>
                <RadioButton Content="仅修改当前选中的块实例（推荐）" GroupName="BlockDimensionScope" Margin="2,4" IsChecked="{Binding ModifySelectedBlockOnly}" />
                <RadioButton Content="修改所有同名块" GroupName="BlockDimensionScope" Margin="2,4" IsChecked="{Binding ModifyAllSameNameBlocks}" />
              </StackPanel>
              <Button Content="选择对象并更换" Height="42" Margin="0,14,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF" Background="#0877D1" BorderBrush="#0868B5" Command="{Binding ApplyDimensionStyleCommand}" />
            </StackPanel>
          </GroupBox>
          <Border Margin="0,14,0,0" Padding="12" Background="#F7FAFC" BorderBrush="#D0D5DC" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="使用方法" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
              <TextBlock Text="1. 选择目标标注样式和块处理范围。&#xA;2. 点击“选择对象并更换”。&#xA;3. 框选任意标注、图形或块，按 Enter 完成。" Foreground="#5C6673" TextWrapping="Wrap" LineHeight="22" />
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
      <TabItem Header="块工具">
        <StackPanel Margin="14">
          <GroupBox BorderBrush="#D0D5DC">
            <HeaderedContentControl.Header>
              <TextBlock Text="镜像块文字校正" Style="{StaticResource GroupTitleStyle}" />
            </HeaderedContentControl.Header>
            <StackPanel Margin="12">
              <TextBlock Text="选择文字反向或标注倒置的块。之前校正过但标注仍倒置的块，也可以再次选择并校正。" Foreground="#5C6673" TextWrapping="Wrap" LineHeight="21" />
              <Button Content="选择镜像块并校正文字" Height="42" Margin="0,14,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF" Background="#0877D1" BorderBrush="#0868B5" Command="{Binding FixMirroredBlockTextCommand}" />
            </StackPanel>
          </GroupBox>
          <Border Margin="0,14,0,0" Padding="12" Background="#F7FAFC" BorderBrush="#D0D5DC" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="说明" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6" />
              <TextBlock Text="• 校正后仍然是一个块，不需要手工分解。&#xA;• 仅修改选中的镜像块，不影响其他同名块。&#xA;• 支持普通嵌套块；不含文字的动态子块保留。&#xA;• 需修改的块会生成独立定义；含文字的动态块、属性块及外部参照等不支持结构会跳过。&#xA;• 也可在命令行输入 CADFIXMIRRORTEXT。" Foreground="#5C6673" TextWrapping="Wrap" LineHeight="22" />
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
      <TabItem Header="输入法" x:Name="InputMethodTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14" x:Name="InputMethodPanel">
            <GroupBox BorderBrush="#D0D5DC" Header="智能输入法切换">
              <StackPanel Margin="12">
                <CheckBox Content="启用 CAD 智能输入法切换" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,12" IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="CAD 在前台时切换为英文键盘布局，方便直接输入命令；切到其他软件时自动还原你原来的中文输入法。" Foreground="#5C6673" TextWrapping="Wrap" LineHeight="21" />
                <TextBlock Text="开关立即生效，自动记住设置。关闭后停止检测和切换，并立即还原中文输入法；关闭工具面板不影响已启用的功能。" Foreground="#5C6673" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0" />
              </StackPanel>
            </GroupBox>
            <Border Margin="0,12,0,0" Padding="12" Background="#F7FAFC" BorderBrush="#D0D5DC" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="运行状态" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,7" />
                <TextBlock Text="{Binding Status}" Foreground="#0877D1" TextWrapping="Wrap" LineHeight="21" />
                <TextBlock Text="{Binding Detail}" Foreground="#79828E" TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
            <TextBlock Margin="2,12,2,0" Text="• 鼠标进入 CAD 主窗口 → 英文&#xA;• 明确进入文字编辑、文件名框 → 中文&#xA;• 手动切换后本次停留不再抢回&#xA;• 鼠标移出再进入 CAD，重新切英文" TextWrapping="Wrap" LineHeight="23" Foreground="#5C6673" />
            <TextBlock Margin="2,10,2,0" Text="请先选中微信输入法、搜狗或微软拼音。本功能切换当前中文输入法的中英文模式；具体输入法版本需实机验证。属性编辑等未识别窗口仍需手动切换。" TextWrapping="Wrap" LineHeight="20" Foreground="#79828E" FontSize="11" />
            <CheckBox Content="开启兼容性诊断（不记录输入内容）" Margin="2,12,2,0" IsChecked="{Binding Diagnostics, Mode=TwoWay}" />
            <TextBlock Text="命令：CADIMEON 开启 / CADIMEOFF 关闭" Margin="2,10,2,0" Foreground="#79828E" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" TextWrapping="Wrap" Margin="2,10,2,0" Foreground="#5C6673" Text="{Binding Status}" />
  </Grid>
</Window>
